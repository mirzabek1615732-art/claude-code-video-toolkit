 "uz": [
  {
   "s": 0.185,
   "e": 1.298,
   "text": "Tezkor savol!"
  },
  {
   "s": 1.298,
   "e": 5.301,
   "text": "Qaysi biri rezavor meva: banan yoki qulupnay?"
  },
  {
   "s": 5.301,
   "e": 6.445,
   "text": "Kutilmagan burilish!"
  },
  {
   "s": 6.445,
   "e": 9.341,
   "text": "Banan rezavor meva hisoblanadi, qulupnay esa yo\u2018q!"
  },
  {
   "s": 9.341,
   "e": 11.186,
   "text": "Botanikada haqiqiy rezavor meva"
  },
  {
   "s": 11.216,
   "e": 13.857,
   "text": "bitta gulning yagona tugunchasidan rivojlanadi."
  },
  {
   "s": 13.857,
   "e": 15.867,
   "text": "Qulupnay esa boshqacha rivojlanadi."
  },
  {
   "s": 15.867,
   "e": 17.853,
   "text": "Uning tashqi yuzasidagi mayda nuqtalar-chi?"
  },
  {
   "s": 17.853,
   "e": 19.933,
   "text": "Aslida ular mitti mevachalar!"
  },
  {
   "s": 19.933,
   "e": 23.289,
   "text": "\u201cPlot twist\u201d degani kutilmagan burilish."
  },
  {
   "s": 23.289,
   "e": 25.979,
   "text": "Tasavvur qiling: qulupnayga u rezavor emasligini aytdingiz."
  },
  {
   "s": 25.979,
   "e": 27.109,
   "text": "Uning javobi-chi?"
  },
  {
   "s": 27.109,
   "e": 29.364,
   "text": "Axir nomimda \u201cBERRY\u201d so\u2018zi turibdi-ku!"
  }
 ],
