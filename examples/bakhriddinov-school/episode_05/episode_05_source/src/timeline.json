 "uz": [
  {
   "s": 0.144,
   "e": 0.846,
   "text": "To\u2018xtang..."
  },
  {
   "s": 0.846,
   "e": 3.641,
   "text": "Miyangiz sizdan nimanidir yashiryapti."
  },
  {
   "s": 3.641,
   "e": 4.971,
   "text": "Burningizni!"
  },
  {
   "s": 5.089,
   "e": 6.656,
   "text": "U ko\u2018rish maydoningizda turadi..."
  },
  {
   "s": 6.686,
   "e": 9.155,
   "text": "lekin miyangiz odatda unga e\u2019tibor bermaydi."
  },
  {
   "s": 10.103,
   "e": 12.858,
   "text": "Rostdan, hozir unga e\u2019tibor berib ko\u2018ring."
  },
  {
   "s": 13.117,
   "e": 14.793,
   "text": "Ana u xira shaklni ko\u2018ryapsizmi?"
  },
  {
   "s": 14.793,
   "e": 16.966,
   "text": "Ha, bu sizning burningiz!"
  },
  {
   "s": 17.092,
   "e": 19.435,
   "text": "Endi esa... uni ko\u2018rmaganga ololmaysiz!"
  },
  {
   "s": 19.435,
   "e": 20.897,
   "text": "\u201cEndi buni ko\u2018rmaganga ololmayman!\u201d"
  },
  {
   "s": 20.897,
   "e": 22.769,
   "text": "Biror narsani payqab, keyin uni payqamay"
  },
  {
   "s": 22.799,
   "e": 25.047,
   "text": "qololmaganimizda shunday deymiz."
  },
  {
   "s": 25.047,
   "e": 26.98,
   "text": "Miyangiz sizga yordam bermoqchi edi."
  },
  {
   "s": 26.98,
   "e": 29.339,
   "text": "Endi kech! Rahmat, miyajon!"
  }
 ],
