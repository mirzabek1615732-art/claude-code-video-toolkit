 "uz": [
  {
   "s": 0.259,
   "e": 2.188,
   "text": "Ertalab juda sekin harakat qilaman deb o\u2018ylaysizmi?"
  },
  {
   "s": 2.188,
   "e": 3.637,
   "text": "Unda Venera bilan tanishing!"
  },
  {
   "s": 3.637,
   "e": 7.735,
   "text": "U o\u2018z o\u2018qi atrofida bir marta aylanishi uchun 243 Yer kuni kerak!"
  },
  {
   "s": 7.938,
   "e": 11.261,
   "text": "Quyosh atrofida aylanib chiqishiga esa bor-yo\u2018g\u2018i 225 kun ketadi!"
  },
  {
   "s": 11.5,
   "e": 13.149,
   "text": "Ha, uning bir marta to\u2018liq aylanishi"
  },
  {
   "s": 13.179,
   "e": 15.577,
   "text": "butun bir yilidan ham uzoqroq davom etadi!"
  },
  {
   "s": 16.094,
   "e": 18.692,
   "text": "Bu \u201cat a snail\u2019s pace\u201d, ya\u2019ni shilliqqurt tezligida!"
  },
  {
   "s": 18.692,
   "e": 21.103,
   "text": "Ma\u2019nosi: juda sekin, imillab."
  },
  {
   "s": 22.989,
   "e": 25.826,
   "text": "Keyingi safar do\u2018stingiz \u201cDeyarli yetib keldim!\u201d desa,"
  },
  {
   "s": 25.886,
   "e": 28.833,
   "text": "so\u2018rang: \u201cYer vaqti bilanmi... yoki Venera vaqti bilanmi?\u201d"
  }
 ],
