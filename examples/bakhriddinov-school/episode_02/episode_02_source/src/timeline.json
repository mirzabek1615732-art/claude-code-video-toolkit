 "uz": [
  {
   "s": 0.242,
   "e": 1.191,
   "text": "Shoshma!"
  },
  {
   "s": 1.221,
   "e": 3.251,
   "text": "Flamingolar pushti rangda tug\u2018ilmaydi."
  },
  {
   "s": 3.251,
   "e": 4.794,
   "text": "Ular kulrang bo\u2018lib tug\u2018iladi!"
  },
  {
   "s": 4.898,
   "e": 6.903,
   "text": "Unda ularni kim bo\u2018yagan?"
  },
  {
   "s": 7.105,
   "e": 8.036,
   "text": "Hech kim."
  },
  {
   "s": 8.066,
   "e": 9.345,
   "text": "Ularni o\u2018z ovqati bo\u2018yagan!"
  },
  {
   "s": 9.498,
   "e": 10.939,
   "text": "Mitti krevetkalar va suvo\u2018tlarda"
  },
  {
   "s": 10.969,
   "e": 12.876,
   "text": "maxsus pigmentlar bor."
  },
  {
   "s": 12.895,
   "e": 13.968,
   "text": "Vaqt o\u2018tishi bilan"
  },
  {
   "s": 13.998,
   "e": 16.187,
   "text": "ular flamingolarni asta-sekin pushti rangga bo\u2018yaydi."
  },
  {
   "s": 16.448,
   "e": 18.033,
   "text": "Shuning uchun shunday deymiz:"
  },
  {
   "s": 18.033,
   "e": 19.935,
   "text": "\u201cNima yesang, o\u2018sha bo\u2018lasan!\u201d"
  },
  {
   "s": 20.496,
   "e": 22.808,
   "text": "Ya\u2019ni yegan ovqating tanangga ta\u2019sir qiladi."
  },
  {
   "s": 24.798,
   "e": 26.307,
   "text": "Xo\u2018sh... har kuni pushti smuzi ichadigan"
  },
  {
   "s": 26.337,
   "e": 27.849,
   "text": "o\u2018sha do\u2018sting-chi?"
  },
  {
   "s": 27.849,
   "e": 29.633,
   "text": "Unga ko\u2018z-quloq bo\u2018lib tur!"
  }
 ],
